# Copier en .env.local. En local, `pnpm db:start` affiche les valeurs à utiliser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (service role) : uniquement côté serveur, jamais exposée au navigateur.
SUPABASE_SECRET_KEY=
# Adresse publique officielle (production : https://sparkly.lbalocchi.fr). Si absente,
# l'adresse réellement utilisée par le visiteur est reprise (previews Vercel, local).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
